# Rendered at start by the official nginx image: ${DOMAIN} comes from the environment.
server_tokens off;
# Host names up to 253 characters (the default bucket only fits about 45, and nginx then refuses to start).
server_names_hash_bucket_size 256;

# Login attempts per client address, in front of the API's own throttle (internal test 2026-11-23).
limit_req_zone $binary_remote_addr zone=fx_login:10m rate=10r/m;

# Requests for any other host name (IP scans, Host-header tricks) are dropped.
server {
    listen 80 default_server;
    listen 443 ssl default_server;
    ssl_reject_handshake on;
    return 444;
}

server {
    listen 80;
    server_name ${DOMAIN} ${RENDER_DOMAIN};

    # Let's Encrypt HTTP-01 challenges for certificate renewal (deploy/renew-cert.sh).
    location /.well-known/acme-challenge/ {
        root /var/www/acme;
    }
    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    http2 on;
    server_name ${DOMAIN};

    ssl_certificate     /certs/fullchain.pem;
    ssl_certificate_key /certs/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;
    # TLS 1.2: forward-secret AEAD ciphers only (no CBC: LUCKY13 finding, 2026-11-23). TLS 1.3 suites are all AEAD.
    ssl_ciphers         ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305;
    ssl_prefer_server_ciphers off;
    ssl_session_cache   shared:TLS:10m;
    ssl_session_tickets off;

    add_header Strict-Transport-Security "max-age=63072000; includeSubDomains" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "no-referrer" always;
    add_header X-Frame-Options "DENY" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
    # Message bodies load in a frame from the render host (FOX-045). style-src 'unsafe-inline' stays for
    # the srcdoc fallback used by installs without a render domain (srcdoc inherits this policy).
    add_header Content-Security-Policy "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; frame-src https://${RENDER_DOMAIN}; frame-ancestors 'none'; base-uri 'none'; form-action 'self'" always;

    client_max_body_size 30m;

    # Optional add-ons (the testing add-on mounts its password gate and Mailpit route here).
    # Empty in a normal install.
    include /etc/nginx/foxalora.d/*.conf;

    # Mailbox login, admin sign-in and admin code entry share the per-address rate limit.
    location ~ ^/api/v1/(auth/login|admin/auth/(login|verify))$ {
        limit_req zone=fx_login burst=10 nodelay;
        limit_req_status 429;
        proxy_pass http://api:3000;
        proxy_set_header Host $host;
        proxy_set_header Authorization "";
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_hide_header Strict-Transport-Security; # sent once, by this server block
    }

    location /api/ {
        proxy_pass http://api:3000;
        proxy_set_header Host $host;
        proxy_set_header Authorization ""; # a password gate's credentials never reach the API
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host; # never the client's own value
        proxy_hide_header Strict-Transport-Security; # sent once, by this server block
        proxy_read_timeout 60s;
    }

    # Hashed build assets can be cached for a long time; index.html never.
    location /assets/ {
        root /usr/share/nginx/html;
        expires 1y;
        add_header Cache-Control "public, immutable" always;
        add_header X-Content-Type-Options "nosniff" always;
    }

    location / {
        root /usr/share/nginx/html;
        try_files $uri /index.html;
        add_header Cache-Control "no-cache" always;
        add_header Strict-Transport-Security "max-age=63072000; includeSubDomains" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "no-referrer" always;
        add_header X-Frame-Options "DENY" always;
        add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
        add_header Content-Security-Policy "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; frame-src https://${RENDER_DOMAIN}; frame-ancestors 'none'; base-uri 'none'; form-action 'self'" always;
    }
}

# FOX-045: the render host shows email bodies from one-time links and nothing else. It is a
# different host name, so the webmail's cookies are never sent here, and it sets none.
server {
    listen 443 ssl;
    http2 on;
    server_name ${RENDER_DOMAIN};

    ssl_certificate     /certs/fullchain.pem;
    ssl_certificate_key /certs/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;
    # TLS 1.2: forward-secret AEAD ciphers only (no CBC: LUCKY13 finding, 2026-11-23). TLS 1.3 suites are all AEAD.
    ssl_ciphers         ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305;
    ssl_prefer_server_ciphers off;
    ssl_session_cache   shared:TLS:10m;
    ssl_session_tickets off;

    add_header Strict-Transport-Security "max-age=63072000; includeSubDomains" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "no-referrer" always;

    location ^~ /api/v1/render/ {
        limit_except GET { deny all; }
        proxy_pass http://api:3000;
        proxy_set_header Host $host;
        proxy_set_header Cookie "";
        proxy_set_header Authorization "";
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host; # never the client's own value
        proxy_hide_header Set-Cookie;
        proxy_hide_header Strict-Transport-Security; # sent once, by this server block
        proxy_read_timeout 30s;
    }

    location / {
        return 404;
    }
}
